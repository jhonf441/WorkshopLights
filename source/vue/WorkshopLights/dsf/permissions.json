{
  "version": 1,
  "plugin": "WorkshopLights",
  "namespace": "lights",
  "prefixes": [
    "light",
    "lights",
    "statuslight"
  ],
  "ui": "ui:lights:open",
  "operations": [
    "light.set",
    "lights.apply_m950",
    "lights.get",
    "lights.import",
    "lights.pi_pins",
    "lights.pi_test",
    "lights.save",
    "lights.scene",
    "lights.test_state",
    "lights.zone",
    "statuslight.set",
    "view.heartbeat"
  ],
